{
  "name": "@observability/auth",
  "version": "1.0.0",
  "description": "Multi-tenant auth module: JWT session verification, Argon2id hashing, RBAC permissions, and API key management",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./contracts/openapi/v1.yaml"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:allure": "vitest run --config vitest.config.ts --reporter=html",
    "test:curl": "./scripts/test-curl-endpoints.sh"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}
