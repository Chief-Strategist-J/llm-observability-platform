{
  "name": "@observability/auth",
  "version": "1.0.0",
  "description": "Multi-tenant auth module: JWT session verification, Argon2id hashing, RBAC permissions, and API key management",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./contracts/openapi/v1.yaml"
  },
  "scripts": {
    "start": "npx tsx src/server.ts",
    "dev": "npx tsx src/server.ts",
    "db:migrate": "npx tsx database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:allure": "vitest run --config vitest.config.ts --reporter=html",
    "test:curl": "./tests/e2e/test-curl-endpoints.sh"
  },
  "dependencies": {
    "@observability/shared-infra": "file:../shared-infra",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}
