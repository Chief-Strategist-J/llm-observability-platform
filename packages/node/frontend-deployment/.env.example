# ─────────────────────────────────────────────────────────────
# LLM Observability Platform — Frontend Deployment Environment
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Domain ──────────────────────────────────────────────────
LLMOBS_DOMAIN=llmobs.local

# ── TLS Certificate Paths (relative to package root) ───────
TLS_CERT_DIR=./config/certs
TLS_CERT_FILE=./config/certs/server.pem
TLS_KEY_FILE=./config/certs/server-key.pem
TLS_CA_FILE=./config/certs/ca.pem

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=<CHANGE_ME>

# ── Grafana ─────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_USERS_ALLOW_ORG_CREATE=false

# ── Kafka ───────────────────────────────────────────────────
KAFKA_CLUSTER_ID=llmobs-kafka-cluster-001

# ── Port Allocation (31410–31419) ───────────────────────────
PORT_TRAEFIK_HTTP=31410
PORT_TRAEFIK_DASHBOARD=31411
PORT_TRAEFIK_HTTPS=31419
PORT_REDIS=31413
PORT_KAFKA=31414
PORT_GRAFANA=31415
PORT_TEMPO=31416
PORT_OTEL_HTTP=31417
PORT_OTEL_GRPC=31418
