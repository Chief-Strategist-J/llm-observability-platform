{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "services": "./scripts/app.sh list",
    "run": "./scripts/app.sh run",
    "auth": "./scripts/app.sh auth",
    "web-app": "./scripts/app.sh web-app",
    "storybook": "storybook dev -p 31406",
    "dev": "./scripts/app.sh dev",
    "dev:all": "./scripts/app.sh dev",
    "dev:next": "./scripts/app.sh web-app",
    "db:up": "./scripts/app.sh db:up",
    "db:migrate": "./scripts/app.sh db:migrate",
    "db:setup": "./scripts/app.sh db:setup",
    "clean": "./scripts/app.sh clean",
    "clean:all": "./scripts/app.sh clean-all",
    "free-ports": "./scripts/app.sh free-ports",
    "install:deps": "./scripts/app.sh install-deps",
    "health": "./scripts/app.sh health",
    "docker:up": "./scripts/app.sh docker-up",
    "docker:down": "./scripts/app.sh docker-down",
    "docker:status": "./scripts/app.sh docker-status",
    "docker:logs": "./scripts/app.sh docker-logs",
    "typecheck": "tsc --noEmit",
    "build": "./scripts/app.sh clean && next build",
    "build:verify": "./scripts/app.sh build-verify",
    "start": "./scripts/app.sh free-ports && next start -p ${PORT_UNIT:-31400}",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:perf": "vitest run tests/performance",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed --project=chromium",
    "test:e2e:ui": "npx playwright test --ui",
    "test:allure": "npx allure generate allure-results --clean -o allure-report",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@observability/api-types": "file:../api-types",
    "@observability/design-tokens": "file:../design-tokens",
    "@observability/realtime-sdk": "file:../realtime-sdk",
    "@observability/shared-infra": "file:../shared-infra",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-web": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@reduxjs/toolkit": "^2.6.0",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.11.0",
    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.470.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.0",
    "react-redux": "^9.2.0",
    "redux-saga": "^1.3.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^2.5.0",
    "uplot": "^1.6.31",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/nextjs-vite": "^10.5.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "eslint-plugin-storybook": "^10.5.6",
    "playwright": "^1.62.1",
    "storybook": "^10.5.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
