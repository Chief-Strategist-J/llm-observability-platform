{
  "name": "@observability/shared-infra",
  "version": "1.0.0",
  "description": "Core engine: httpClient, adapters, decorators, event bus, rules engine, feature flags, centralized OpenTelemetry & messaging tracing",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http/http-client.ts",
    "./store": "./src/store/index.ts",
    "./data-driven": "./src/data-driven/index.ts",
    "./event-bus": "./src/event-bus/event-bus.ts",
    "./rules-engine": "./src/rules-engine/index.ts",
    "./feature-flags": "./src/feature-flags/resolve-flag.ts",
    "./kafka": "./src/kafka/kafka-client.ts",
    "./tracing": "./src/tracing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@reduxjs/toolkit": "^2.6.0",
    "redux-saga": "^1.3.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-redux": ">=9"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "react": "^19.0.0",
    "react-redux": "^9.2.0",
    "typescript": "^5.4.0"
  }
}
