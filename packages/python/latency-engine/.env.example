# Kafka consumer
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=latency-engine-cg
KAFKA_TOPIC_INPUT=llm.spans.raw

# Redis
REDIS_URL=redis://localhost:6379/0

# SLO config
SLO_CONFIG_PATH=src/slo_config.yaml

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Temporal (baseline scheduler)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=latency-baseline-tasks

# Health server
HEALTH_PORT=8003

# OTEL
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
DEPLOYMENT_ENV=dev
SKIP_CONSOLE_EXPORTER=false
SKIP_OTLP_EXPORTER=true
