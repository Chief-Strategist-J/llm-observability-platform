# ─────────────────────────────────────────────────────────────
# LLM Observability Platform — Infrastructure Environment Variables
# Copy this file to .env and adjust your configuration.
# ─────────────────────────────────────────────────────────────

# ── Platform Domain & Gateway ────────────────────────────────
LLMOBS_DOMAIN=llmobs.local

# ── TLS Certificate Paths ────────────────────────────────────
TLS_CERT_DIR=./config/certs
TLS_CERT_FILE=./config/certs/server.pem
TLS_KEY_FILE=./config/certs/server-key.pem
TLS_CA_FILE=./config/certs/ca.pem

# ── Redis Spend Ledger ───────────────────────────────────────
REDIS_PASSWORD=llmobs_redis_s3cret_2024
REDIS_MAX_MEMORY=256mb
REDIS_EVICTION_POLICY=allkeys-lru

# ── Kafka & Redpanda Event Streaming ─────────────────────────
KAFKA_CLUSTER_ID=llmobs-kafka-cluster-001
KAFKA_NUM_PARTITIONS=3

# ── AlloyDB Omni Relational Database ─────────────────────────
ALLOYDB_USER=admin
ALLOYDB_PASSWORD=llmobs_s3cret_2026
ALLOYDB_DB=llm_observability

# ── ClickHouse Analytics Columnar Database ───────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=llmobs_clickhouse_s3cret_2026
CLICKHOUSE_DB=llm_telemetry_analytics

# ── Temporal Workflow Engine ────────────────────────────────
TEMPORAL_UI_PORT=8088
TEMPORAL_GRPC_PORT=7233

# ── Grafana Telemetry Dashboard ─────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=llmobs_admin_password
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_USERS_ALLOW_ORG_CREATE=false

# ── Port Allocations (31410–31425) ──────────────────────────
PORT_TRAEFIK_HTTP=31410
PORT_TRAEFIK_DASHBOARD=31411
PORT_REDIS=31413
PORT_KAFKA=31414
PORT_GRAFANA=31415
PORT_TEMPO=31416
PORT_OTEL_HTTP=31417
PORT_OTEL_GRPC=31418
PORT_TRAEFIK_HTTPS=31419
PORT_ALLOYDB=31420
PORT_CLICKHOUSE_HTTP=31421
PORT_CLICKHOUSE_NATIVE=31422
PORT_TEMPO_OTLP_GRPC=31423
PORT_TEMPORAL_GRPC=31424
PORT_TEMPORAL_UI=31425
